<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="28dp">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/SheetTitle"
            android:layout_width="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="0"
            android:text="Menu" />

        <TextView
            android:id="@+id/toolPageHost"
            style="@style/SheetSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="2dp"
            android:ellipsize="middle"
            android:singleLine="true" />

        <!-- Quick actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/toolShare"
                style="@style/ToolTile">

                <ImageView
                    style="@style/ToolTileIcon"
                    android:src="@drawable/ic_share" />

                <TextView
                    style="@style/ToolTileLabel"
                    android:text="Share" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/toolCopy"
                style="@style/ToolTile">

                <ImageView
                    style="@style/ToolTileIcon"
                    android:src="@drawable/ic_copy" />

                <TextView
                    style="@style/ToolTileLabel"
                    android:text="Copy link" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/toolExternal"
                style="@style/ToolTile">

                <ImageView
                    style="@style/ToolTileIcon"
                    android:src="@drawable/ic_open" />

                <TextView
                    style="@style/ToolTileLabel"
                    android:text="Open in…" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/toolRefresh"
                style="@style/ToolTile">

                <ImageView
                    style="@style/ToolTileIcon"
                    android:src="@drawable/ic_refresh" />

                <TextView
                    style="@style/ToolTileLabel"
                    android:text="Hard reload" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/SheetSectionLabel"
            android:text="Browsing" />

        <LinearLayout
            android:id="@+id/toolCardMain"
            style="@style/SheetCard" />

        <TextView
            style="@style/SheetSectionLabel"
            android:text="Page text size" />

        <LinearLayout
            style="@style/SheetCard"
            android:padding="12dp">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toolZoom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/zoom85"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="85%" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/zoom100"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="100%" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/zoom125"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="125%" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/zoom150"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="150%" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <TextView
            style="@style/SheetSectionLabel"
            android:text="Privacy" />

        <LinearLayout
            android:id="@+id/toolCardDanger"
            style="@style/SheetCard" />

        <TextView
            android:id="@+id/toolVersion"
            style="@style/SheetHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
