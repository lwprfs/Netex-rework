<?xml version="1.0" encoding="utf-8"?>
<!-- Root is a FrameLayout so the floating controls can sit on top of the whole browser UI. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainer">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">


    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="6dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1" />

    <com.mrdoob.browser.DragInterceptLinearLayout
        android:id="@+id/chromeContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainer"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingHorizontal="10dp">

        <!-- Drag / tap handle that opens the devtools panel -->
        <FrameLayout
            android:id="@+id/dragHandle"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:clickable="true"
            android:contentDescription="Toggle developer tools"
            android:focusable="true">

            <View
                android:layout_width="36dp"
                android:layout_height="5dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_drag_handle"
                android:alpha="0.55" />
        </FrameLayout>

        <!-- URL pill -->
        <LinearLayout
            android:id="@+id/urlBubble"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/url_bar_bubble"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="4dp">

            <ImageView
                android:id="@+id/securityIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_search"
                android:contentDescription="Connection security"
                app:tint="?attr/colorOnSurfaceVariant" />

            <ImageView
                android:id="@+id/faviconIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:contentDescription="Site icon"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <EditText
                android:id="@+id/urlBar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@null"
                android:gravity="center_vertical"
                android:hint="@string/url_hint"
                android:importantForAutofill="no"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:padding="0dp"
                android:singleLine="true"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                android:textSize="15.5sp" />

            <ImageButton
                android:id="@+id/panelReload"
                style="@style/PanelIconButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:contentDescription="Reload"
                android:src="@drawable/ic_refresh" />
        </LinearLayout>

        <!-- Navigation row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/navBack"
                style="@style/NavButton"
                android:contentDescription="Back"
                android:src="@drawable/ic_back" />

            <ImageButton
                android:id="@+id/navForward"
                style="@style/NavButton"
                android:contentDescription="Forward"
                android:src="@drawable/ic_forward" />

            <ImageButton
                android:id="@+id/navDevtools"
                style="@style/NavButton"
                android:contentDescription="Developer tools"
                android:src="@drawable/ic_code" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageButton
                    android:id="@+id/menuButton"
                    style="@style/NavButton"
                    android:layout_width="match_parent"
                    android:layout_weight="0"
                    android:contentDescription="Menu"
                    android:src="@drawable/ic_tune" />

                <View
                    android:id="@+id/recBadge"
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_rec_badge"
                    android:visibility="gone" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/threeLogoButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/ripple_round"
                android:clickable="true"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:contentDescription="Three.js tools"
                android:focusable="true">

                <ImageView
                    android:id="@+id/threeLogo"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:alpha="0.3"
                    android:contentDescription="three.js detection status"
                    android:src="@drawable/three_logo" />

                <TextView
                    android:id="@+id/revisionBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="1dp"
                    android:background="@drawable/revision_badge_bg"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="3dp"
                    android:paddingVertical="1dp"
                    android:textColor="?attr/colorOnPrimary"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:visibility="invisible" />
            </FrameLayout>
        </LinearLayout>
    </com.mrdoob.browser.DragInterceptLinearLayout>

    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="?attr/colorSurfaceContainer"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/panelTabs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                app:tabGravity="fill"
                app:tabIndicatorFullWidth="false"
                app:tabMode="fixed">

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Console" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Source" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Network" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Three.js" />
            </com.google.android.material.tabs.TabLayout>

            <ImageButton
                android:id="@+id/panelClear"
                style="@style/PanelIconButton"
                android:contentDescription="Clear"
                android:src="@drawable/ic_sweep" />

            <ImageButton
                android:id="@+id/panelExpand"
                style="@style/PanelIconButton"
                android:contentDescription="Expand developer tools"
                android:src="@drawable/ic_fullscreen" />

            <ImageButton
                android:id="@+id/panelClose"
                style="@style/PanelIconButton"
                android:contentDescription="Close developer tools"
                android:src="@drawable/ic_expand_more" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="6dp"
            android:layout_marginBottom="6dp"
            android:layout_weight="1">

            <WebView
                android:id="@+id/panelView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <WebView
                android:id="@+id/threePanelView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>

</FrameLayout>
