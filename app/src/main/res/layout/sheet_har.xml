<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="28dp">

        <TextView
            style="@style/SheetTitle"
            android:text="Network recording" />

        <LinearLayout
            style="@style/SheetCard"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/harDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/dot" />

                <TextView
                    android:id="@+id/harStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/harFile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/harStart"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Start new" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/harPause"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Pause" />
        </LinearLayout>

        <TextView
            style="@style/SheetRowSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="20dp"
            android:text="Export" />

        <LinearLayout
            style="@style/SheetCard"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:id="@+id/harShare"
                style="@style/SheetRow"
                android:orientation="vertical"
                android:gravity="start">

                <TextView
                    style="@style/SheetRowTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Share" />

                <TextView
                    style="@style/SheetRowSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Send the .har file to another app" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="16dp"
                android:background="?attr/colorOutlineVariant" />

            <LinearLayout
                android:id="@+id/harSave"
                style="@style/SheetRow"
                android:orientation="vertical"
                android:gravity="start">

                <TextView
                    style="@style/SheetRowTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Save to Downloads" />

                <TextView
                    style="@style/SheetRowSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Saved straight to Downloads/Netex" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="16dp"
                android:background="?attr/colorOutlineVariant" />

            <LinearLayout
                android:id="@+id/harFiles"
                style="@style/SheetRow"
                android:orientation="vertical"
                android:gravity="start">

                <TextView
                    style="@style/SheetRowTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="File manager" />

                <TextView
                    style="@style/SheetRowSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Choose where to save it" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            style="@style/SheetCard"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:id="@+id/harClear"
                style="@style/SheetRow"
                android:orientation="vertical"
                android:gravity="start">

                <TextView
                    style="@style/SheetRowTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clear recording"
                    android:textColor="?attr/colorError" />

                <TextView
                    style="@style/SheetRowSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Deletes the current and cached .har files" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
